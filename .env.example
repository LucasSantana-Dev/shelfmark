# shelfmark environment configuration — every variable is optional.
# Source this (or export in your shell profile) before running build/query/MCP.

# Data directory (index.sqlite, sources.yaml, backups)
#RAG_HOME=~/.shelfmark

# Explicit index path (overrides $RAG_HOME/index.sqlite)
#RAG_DB=

# Corpus definition file (default $RAG_HOME/sources.yaml)
#RAG_SOURCES=

# Embedding model + its dimension (must match each other; reindex after changing)
#RAG_MODEL=intfloat/multilingual-e5-small
#RAG_DIM=384

# Retrieval tuning
#RAG_HYBRID=1                 # 1 = BM25+cosine RRF fusion (default), 0 = cosine only
#RAG_BM25_WEIGHT=1.5          # >1 favors lexical match (good for code)
#RAG_RECENCY_WEIGHT=0         # gentle freshness tie-break for memory scope (0 = off)

# Reranking (cross-encoder)
#RAG_RERANK=off               # force rerank on every query
#RAG_RERANK_AUTO=on           # auto-rerank weak/ambiguous queries
#RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#RAG_CODE_RERANK=off          # selective rerank for code/standards scopes
                              # (pair with RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3, ~2.2GB)

# MCP search_knowledge tool: which source_type labels count as knowledge
#RAG_KNOWLEDGE_SCOPE=memory,standards,plans,handoffs,adrs

# Session transcript indexing (session_chunker.py)
#RAG_SESSIONS_DIR=~/.claude/projects

# Local query telemetry (queries.sqlite, powers report.py). OFF by default.
#RAG_QLOG=off
