# shelfmark corpus configuration.
# Copy to $RAG_HOME/sources.yaml (default ~/.shelfmark/sources.yaml) and edit.
# ~ and $VARS are expanded in every path.

# Code repos: indexed for source code (py/ts/js/sh), docs/**/*.md, README.md,
# CHANGELOG.md, docs/specs/**, docs/roadmap.md, and the last 180 days of git
# commit messages. Auto-scoping at query time keys off these paths.
repos:
  - ~/dev/my-main-project
  - ~/dev/another-repo

# Markdown corpora: type is a free label you filter on at query time
# (--scope <type> / scope_types). Globs support * and **.
sources:
  - type: memory
    glob: ~/notes/memory/**/*.md
  - type: standards
    glob: ~/notes/standards/*.md
  - type: plans
    glob: ~/notes/plans/*.md

# Loose scripts outside any repo, indexed as source_type=workstation-code.
code_globs:
  - ~/scripts/*.sh

# Client layers: each client's knowledge goes to its own index file and is
# only read while that client is active (RAG_CLIENT, or cwd under its roots).
# Frontmatter `client: <slug>` routes a note explicitly; `client: none` keeps
# it general even inside a client root.
clients:
  acme:
    roots:
      - ~/dev/acme-app
      - ~/notes/acme
